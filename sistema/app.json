{
  "expo": {
    "name": "AgroSmart-Skeleton",
    "slug": "agrosmart-skeleton",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "agrosmart",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.example.agrosmart"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
