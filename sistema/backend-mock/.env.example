# Copia este archivo como .env y completa los valores. Nunca subas .env a Git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion

# Langflow: configura estos valores despues de crear y publicar el flujo.
LANGFLOW_URL=http://localhost:7860
LANGFLOW_FLOW_ID=tu_LANGFLOW_ID
LANGFLOW_API_KEY=tu_LANGFLOW_API_KEY
